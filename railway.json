{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm --prefix client install && npm --prefix client run build"
  },
  "deploy": {
    "startCommand": "npm --prefix server start",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
